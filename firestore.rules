rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidSettings(s) {
      return s is map
        && s.keys().hasAll([
          'layout',
          'practiceMode',
          'targetWpm',
          'dailyGoalMinutes',
          'lessonWordCount',
          'showKeyboard',
          'showFingerColors',
          'showKeystrokeHints',
          'soundEnabled',
          'stopOnError',
          'includePunctuation',
          'theme',
          'customText'
        ])
        && s.keys().hasOnly([
          'layout',
          'practiceMode',
          'targetWpm',
          'dailyGoalMinutes',
          'lessonWordCount',
          'showKeyboard',
          'showFingerColors',
          'showKeystrokeHints',
          'soundEnabled',
          'stopOnError',
          'includePunctuation',
          'theme',
          'customText',
          'freeHandChars'
        ])
        && (!('freeHandChars' in s) || (
          s.freeHandChars is list
          && s.freeHandChars.size() >= 2
          && s.freeHandChars.size() <= 64
          && s.freeHandChars[0] is string
          && s.freeHandChars[0].size() <= 4
        ))
        && s.layout is string
        && s.layout.size() <= 16
        && s.layout in ['probhat', 'unijoy', 'jatiya', 'ime']
        && s.practiceMode is string
        && s.practiceMode.size() <= 16
        && s.practiceMode in ['guided', 'all', 'conjuncts', 'custom', 'freehand']
        && s.targetWpm is number
        && s.targetWpm >= 10
        && s.targetWpm <= 120
        && s.dailyGoalMinutes is number
        && s.dailyGoalMinutes >= 1
        && s.dailyGoalMinutes <= 240
        && s.lessonWordCount is number
        && s.lessonWordCount >= 5
        && s.lessonWordCount <= 60
        && s.showKeyboard is bool
        && s.showFingerColors is bool
        && s.showKeystrokeHints is bool
        && s.soundEnabled is bool
        && s.stopOnError is bool
        && s.includePunctuation is bool
        && s.theme is string
        && s.theme.size() <= 10
        && s.theme in ['light', 'dark']
        && s.customText is string
        && s.customText.size() <= 8000;
    }

    function isValidFreeHandStats(fh) {
      return fh is map
        && fh.keys().hasAll([
          'totalLessons',
          'totalCharsTyped',
          'totalDurationMs',
          'topWpm',
          'keyStats',
          'dailyStats'
        ])
        && fh.keys().hasOnly([
          'totalLessons',
          'totalCharsTyped',
          'totalDurationMs',
          'topWpm',
          'keyStats',
          'dailyStats'
        ])
        && fh.totalLessons is int
        && fh.totalLessons >= 0
        && fh.totalCharsTyped is int
        && fh.totalCharsTyped >= 0
        && fh.totalDurationMs is number
        && fh.totalDurationMs >= 0
        && fh.topWpm is number
        && fh.topWpm >= 0
        && fh.topWpm <= 400
        && fh.keyStats is map
        && fh.keyStats.size() <= 120
        && fh.dailyStats is map
        && fh.dailyStats.size() <= 400;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'ownerId',
          'displayName',
          'email',
          'totalLessons',
          'totalCharsTyped',
          'totalDurationMs',
          'topWpm',
          'unlockedChars',
          'manualFocusChar',
          'keyStats',
          'dailyStats',
          'settings',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'displayName',
          'email',
          'totalLessons',
          'totalCharsTyped',
          'totalDurationMs',
          'topWpm',
          'unlockedChars',
          'ignoredChars',
          'manualFocusChar',
          'keyStats',
          'dailyStats',
          'settings',
          'freeHandStats',
          'createdAt',
          'updatedAt'
        ])
        && (!('freeHandStats' in data) || isValidFreeHandStats(data.freeHandStats))
        && (!('ignoredChars' in data) || (
          data.ignoredChars is list
          && data.ignoredChars.size() <= 64
          && (data.ignoredChars.size() == 0 || (data.ignoredChars[0] is string && data.ignoredChars[0].size() <= 4))
        ))
        && data.ownerId is string
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 40
        && data.email is string
        && data.email.size() <= 120
        && data.totalLessons is int
        && data.totalLessons >= 0
        && data.totalCharsTyped is int
        && data.totalCharsTyped >= 0
        && data.totalDurationMs is number
        && data.totalDurationMs >= 0
        && data.topWpm is number
        && data.topWpm >= 0
        && data.topWpm <= 400
        && data.unlockedChars is list
        && data.unlockedChars.size() >= 1
        && data.unlockedChars.size() <= 64
        && data.unlockedChars[0] is string
        && data.unlockedChars[0].size() <= 4
        && data.manualFocusChar is string
        && data.manualFocusChar.size() <= 4
        && data.keyStats is map
        && data.keyStats.size() <= 120
        && data.dailyStats is map
        && data.dailyStats.size() <= 400
        && isValidSettings(data.settings)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLessonEntry(data) {
      return data.keys().hasAll([
          'ownerId',
          'layout',
          'mode',
          'wpm',
          'cpm',
          'accuracy',
          'errorRate',
          'durationMs',
          'charCount',
          'errorCount',
          'focusChar',
          'unlockedChar',
          'timestamp',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'layout',
          'mode',
          'wpm',
          'cpm',
          'accuracy',
          'errorRate',
          'durationMs',
          'charCount',
          'errorCount',
          'focusChar',
          'unlockedChar',
          'timestamp',
          'createdAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.layout is string
        && data.layout.size() <= 16
        && data.layout in ['probhat', 'unijoy', 'jatiya', 'ime']
        && data.mode is string
        && data.mode.size() <= 16
        && data.mode in ['guided', 'all', 'conjuncts', 'custom', 'freehand']
        && data.wpm is number
        && data.wpm >= 0
        && data.wpm <= 400
        && data.cpm is number
        && data.cpm >= 0
        && data.cpm <= 2000
        && data.accuracy is number
        && data.accuracy >= 0
        && data.accuracy <= 100
        && data.errorRate is number
        && data.errorRate >= 0
        && data.errorRate <= 100
        && data.durationMs is number
        && data.durationMs >= 0
        && data.charCount is int
        && data.charCount >= 0
        && data.errorCount is int
        && data.errorCount >= 0
        && data.focusChar is string
        && data.focusChar.size() <= 4
        && data.unlockedChar is string
        && data.unlockedChar.size() <= 4
        && data.timestamp is number
        && data.timestamp > 0
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId) && isVerified();
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isVerified()
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isVerified()
        && isValidUserProfile(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['settings', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['unlockedChars', 'manualFocusChar', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['unlockedChars', 'ignoredChars', 'manualFocusChar', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['ignoredChars', 'manualFocusChar', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['freeHandStats', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'totalLessons',
            'totalCharsTyped',
            'totalDurationMs',
            'topWpm',
            'unlockedChars',
            'ignoredChars',
            'manualFocusChar',
            'keyStats',
            'dailyStats',
            'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'totalLessons',
            'totalCharsTyped',
            'totalDurationMs',
            'topWpm',
            'unlockedChars',
            'manualFocusChar',
            'keyStats',
            'dailyStats',
            'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'totalLessons',
            'totalCharsTyped',
            'totalDurationMs',
            'topWpm',
            'unlockedChars',
            'ignoredChars',
            'manualFocusChar',
            'keyStats',
            'dailyStats',
            'freeHandStats',
            'updatedAt'
          ])
        );
      allow delete: if isValidId(userId) && isOwner(userId) && isVerified();

      match /lessons/{lessonId} {
        allow get: if isValidId(userId) && isValidId(lessonId) && isOwner(userId) && isVerified();
        allow list: if isValidId(userId) && isOwner(userId) && isVerified() && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(lessonId)
          && isOwner(userId)
          && isVerified()
          && isValidLessonEntry(incoming())
          && incoming().createdAt == request.time
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(lessonId) && isOwner(userId) && isVerified();
      }
    }
  }
}
